<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <TextView
        android:text="Upload Mechanic Roster"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/bmw_m_dark_blue"
        android:layout_marginBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <EditText
        android:id="@+id/et_roster_filename"
        android:hint="upload_roster.xlsx"
        android:background="@android:drawable/editbox_background"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_upload_roster"
        android:text="Upload"
        android:textAllCaps="false"
        android:backgroundTint="@color/bmw_m_blue"
        android:textColor="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
